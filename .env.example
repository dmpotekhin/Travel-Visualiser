# HERE API key (optional). Get free key at https://developer.here.com/
# Without a key the app uses Nominatim geocoding + great-circle (haversine)
# distances as a fallback. With a key, real road/rail distances and geometry
# are used via HERE Routing/Matrix API.
HERE_API_KEY=

# Routing providers (all optional, chain order below)
# OSRM public demo server (no key) or your self-hosted instance, e.g.
#   https://router.project-osrm.org  or  http://127.0.0.1:5000
OSRM_BASE_URL=
# GraphHopper cloud API (free key at https://graphhopper.com/) or self-hosted.
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
# Provider priority: "auto" = HERE,OSRM,GRAPHHOPPER,GREAT_CIRCLE.
# Any subset works, e.g. "OSRM,GRAPHHOPPER" (unconfigured providers are skipped).
ROUTING_PROVIDER_ORDER=auto
# "true": fall back to the great-circle model when every provider fails (never
# errors). "false": strict mode - raise an error instead of silent fallback.
ROUTING_FALLBACK_ENABLED=true

# LLM API key (optional). Enables AI parsing of natural-language route
# descriptions ("из СПб в Москву, потом в Пекин на поезде"). Without a key the
# app falls back to a deterministic heuristic parser. Any OpenAI-compatible
# endpoint works. Examples:
#   DeepSeek:    LLM_URL=https://api.deepseek.com/chat/completions, model deepseek-chat
#   HuggingFace: LLM_URL=https://router.huggingface.co/v1/chat/completions,
#                model e.g. zai-org/GLM-4.7-Flash or Qwen/Qwen3.5-35B-A3B (free tier)
# Legacy DEEPSEEK_* names are still accepted as aliases.
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_URL=https://api.deepseek.com/chat/completions
LLM_MAX_TOKENS=1024
# Optional extra JSON merged into the chat/completions body. Example for Qwen
# models on HuggingFace (disables hidden "thinking" tokens so the plain answer
# comes back fast):
#   LLM_EXTRA_JSON={"chat_template_kwargs":{"enable_thinking":false}}

# Cesium ion access token (optional). Enables real 3D terrain + premium imagery
# on the 3D globe. Without a token the globe uses flat ellipsoid terrain and
# free OpenStreetMap imagery. Get a token at https://ion.cesium.com/
CESIUM_ION_TOKEN=

# Server settings (optional)
HOST=127.0.0.1
PORT=8000
