# HERE API key (optional). Get free key at https://developer.here.com/
# Without a key the app uses Nominatim geocoding + great-circle (haversine)
# distances as a fallback. With a key, real road/rail distances and geometry
# are used via HERE Routing/Matrix API.
HERE_API_KEY=

# Server settings (optional)
HOST=127.0.0.1
PORT=8000
